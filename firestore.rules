rules_version = '2';
/* =====================================================================
   AKÜ Moleküler Biyoloji ve Genetik Topluluğu — DNA Takvimi
   Firestore güvenlik kuralları  (v3.6.0)
   ---------------------------------------------------------------------
   NASIL KULLANILIR:
   1) Firebase konsolu → Firestore Database → Rules
   2) Aşağıdaki metnin TAMAMINI sil, bunu yapıştır
   3) Publish
   ---------------------------------------------------------------------
   YETKİ NASIL BELİRLENİR?
   Yönetici, Firestore belgesindeki role alanına değil, GİRİŞ YAPAN
   hesabın e-postasına bakılarak belirlenir:
       request.auth.token.email == 'b.gul.baba.can@hotmail.com'
   Böylece ilk yönetici hesabının profil belgesi silinse bile yetkisi
   kaybolmaz. Bu e-posta Firebase Auth'a kayıtlıdır; parolayı yalnızca
   hesap sahibi bilir.
   ---------------------------------------------------------------------
   • ÜYELİK: yalnızca e-postası DOĞRULANMIŞ hesaplar members belgesi
     oluşturabilir. Doğrulanmamış hesap veritabanına üye yazılmaz.
   • PROFİL: kullanıcı kendi profilini günceller ama en fazla
     30 GÜNDE BİR (ayda bir kere). İlk üyelikten itibaren sayılır.
   • PLAN (events)     : herkes okur, yalnızca yönetici yazar
   • KAYIT (regs)      : üye yalnızca kendi kaydını ekler/siler
   • DUYURULAR (news)  : herkes okur, yalnızca yönetici yazar
   • GERİ BİLDİRİM     : reports + oneriler — herkes yazar,
                         YALNIZCA yönetici okur
   • ETKİNLİK SAYFASI   : events/{id}/sayfa — herkes okur, yönetici yazar
   • KATILIM QR        : events/{id}/qr — yönetici yazar (10 sn yenilenir)
   • KATILANLAR        : üye YALNIZCA geçerli QR kodunu göstererek kendi
                        kaydını yazabilir; başkasının katılımı yazılamaz
   • GÖREVLİLER        : events/{id}/gorevli — herkes okur, yönetici atar
   • KİŞİSEL VERİLER    : not/görev yalnızca sahibine; katılım artık üye
                        tarafından seçilemez
   • HERKESE AÇIK ÜYE SAYISI: public/{uid} — yalnızca ad soyad ve
                        katılım/görev sayıları (İletişim bilgisi YOK)
   • GERİ KALAN HER ŞEY: KAPALI
   ===================================================================== */
service cloud.firestore {
  match /databases/{database}/documents {

    function girisYapildi() {
      return request.auth != null;
    }

    function adminMail() {
      return 'b.gul.baba.can@hotmail.com';
    }

    /* Yönetici = bu e-posta ile giriş yapmış hesap */
    function adminMi() {
      return girisYapildi()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == adminMail().lower();
    }

    /* E-postası doğrulanmış kullanıcı */
    function dogrulandiMi() {
      return girisYapildi()
        && request.auth.token.email_verified == true;
    }

    /* Profil güncelleme aralığı: 30 gün */
    function profilSikiliMi() {
      /* DİKKAT: eksik alana doğrudan erişmek kuralı HATA ile düşürür
         ("field doesn't exist → error → deny"). Bu yüzden önce varlık
         yoklanır; aksi hâlde profilini hiç güncellememiş üye kendi
         profilini de güncelleyemezdi. */
      return 'profilGuncelAt' in resource.data
        && request.time - resource.data.profilGuncelAt < duration.value(30, 'd');
    }

    /* --- ÜYE PROFİLLERİ --- */
    match /members/{uid} {
      /* KRİTİK (KVKK + sızıntı): bu belge e-posta, öğrenci no ve telefonu
         İÇERİR. "Herkese açık" gizlilik ayarı BUNU açmaz — aksi hâlde
         e-posta gizlemeyi seçen üyenin adresi ham dokümanla sızar.
         Bu yüzden members/{uid} YALNIZCA sahibine ve yöneticiye açıktır.
         Başkalarının profili aşağıdaki paylasim/{uid} belgesinden,
         kullanıcının izin verdiği alanlarla okunur. */
      allow read: if adminMi() || (girisYapildi() && request.auth.uid == uid);

      /* YALNIZCA doğrulanmış e-posta üye olabilir */
      allow create: if girisYapildi()
        && request.auth.uid == uid
        && dogrulandiMi()
        && request.resource.data.keys().hasOnly([
             'email', 'name', 'no', 'dept', 'girisYili',
             'rol', 'dogrulandi', 'olusturmaAt', 'telefon'])
        && request.resource.data.dogrulandi == true
        /* uye kendine rol veremez; yalnizca yonetici e-postasi admin olabilir */
        && (request.resource.data.rol == 'uye'
            || (request.auth.token.email != null
                && request.auth.token.email.lower() == adminMail().lower()));

      /* Yönetici her zaman düzenleyebilir.
         Üye kendi bilgilerini düzenler ama en fazla 30 GÜNDE BİR.
         Kilit süresince yalnızca kendi damgalarını (şifre değişikliği gibi)
         güncelleyebilir; profil alanlarına dokunamaz. */
      allow update: if adminMi()
        || (girisYapildi()
            && request.auth.uid == uid
            && dogrulandiMi()
            /* rol, dogrulandi ve e-posta yalnizca yonetici tarafindan degisir */
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['name', 'no', 'dept', 'girisYili',
                           'profilGuncelAt', 'sifreDegistiAt', 'sifreSayisi',
                           'telefon'])
            /* rol, dogrulandi ve e-posta yalnizca AYNI degerle yazilabilir
               (kendini yonetici yapma / e-posta taklidi engellenir) */
            && request.resource.data.rol == resource.data.rol
            && request.resource.data.dogrulandi == resource.data.dogrulandi
            && request.resource.data.email == resource.data.email
            /* 30 günlük profil kilidi: yalnızca kendi damgaları güncellenir.
               NOT: gizlilik ayarları artık paylasim/{uid} belgesindedir,
               bu yüzden kilit KVKK hakkını engellemez. */
            && (!profilSikiliMi()
                || request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['sifreDegistiAt', 'sifreSayisi', 'profilGuncelAt']))
            /* profilGuncelAt yalnızca SUNUCU zamanı olabilir → 30 günlük
               sayacı kendisi ileri atlatamaz */
            && (!('profilGuncelAt'
                    in request.resource.data.diff(resource.data).affectedKeys())
                || request.resource.data.profilGuncelAt == request.time));

      /* NOT: 'telefon' yalnızca rakım/+ içerebilir ve kısa olmalıdır
         (serbest metin → arayüzde beklenmedik içerik) */
      /* yönetici istediğini siler; üye de kendi hesabını silebilir
         (KVKK: hesap silme hakkı) */
      allow delete: if adminMi() || (girisYapildi() && request.auth.uid == uid);
    }

    /* --- PAYLAŞILAN PROFİL (KVKK) --------------------------------------
       Üye, paylaşmak istediği alanları YALNIZCA buraya yazar:
         gizlilik : 'herkese' | 'uyeler' | 'ben'
         paylas   : { no, bolum, yil, eposta, telefon, istatistik,
                      katilim, gorev } (true/false)
       Kural yalnızca belgede GERÇEKTEN bulunan alanları açar; gizlenen
       alan hiçbir koşulda okunamaz (arayüz değil, VERİTABANI koruması). */
    match /paylasim/{uid} {
      /* resource != null → koleksiyon sorgusu üyeye KAPALI (kimse tüm
         üye profillerini topluca çekemez), yalnızca tek belge okunur. */
      allow read: if adminMi()
        || (girisYapildi() && request.auth.uid == uid)
        || (resource != null
            && (resource.data.gizlilik == 'herkese'
                || (girisYapildi() && dogrulandiMi()
                    && resource.data.gizlilik == 'uyeler')));

      allow create, update: if girisYapildi()
        && request.auth.uid == uid
        && dogrulandiMi()
        && request.resource.data.keys().hasOnly([
             'gizlilik', 'paylas', 'ad', 'no', 'bolum', 'yil',
             'eposta', 'telefon', 'katildi', 'gorevli', 'guncelleAt'])
        && request.resource.data.gizlilik in ['herkese', 'uyeler', 'ben']
        && request.resource.data.paylas.keys().hasOnly([
             'no', 'bolum', 'yil', 'eposta', 'telefon',
             'istatistik', 'katilim', 'gorev'])
        /* İletişim/kimlik alanı yalnızca paylasımı AÇIKKEN yazılabilir
           (yoksa belgeye hiç yazılmaz → gizli kalır) */
        /* KAPALI ALAN BOŞ YAZILIR: her alan paylaşım iznine bağlıdır
           (arayüz değil, VERİTABANI koruması) */
        && (!request.resource.data.no || request.resource.data.paylas.no == true)
        && (!request.resource.data.bolum
            || request.resource.data.paylas.bolum == true)
        && (!request.resource.data.yil
            || request.resource.data.paylas.yil == true)
        && (!request.resource.data.eposta
            || request.resource.data.paylas.eposta == true)
        && (!request.resource.data.telefon
            || request.resource.data.paylas.telefon == true)
        /* tip ve uzunluk doğrulaması (arayüz/HTML güvenliği) */
        && request.resource.data.ad is string
        && request.resource.data.ad.size() <= 80
        && request.resource.data.no is string
        && request.resource.data.no.size() <= 20
        && request.resource.data.bolum is string
        && request.resource.data.bolum.size() <= 80
        && request.resource.data.yil is string
        && request.resource.data.yil.size() <= 10
        && request.resource.data.eposta is string
        && request.resource.data.eposta.size() <= 120
        && request.resource.data.telefon is string
        && request.resource.data.telefon.size() <= 20
        && request.resource.data.katildi is int
        && request.resource.data.gorevli is int
        && request.resource.data.guncelleAt == request.time;

      allow delete: if adminMi() || (girisYapildi() && request.auth.uid == uid);
    }

    /* --- PLAN: herkese açık okunur, yalnızca yönetici yazar --- */
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if adminMi();
    }

    /* --- ETKİNLİK KAYITLARI --- */
    match /regs/{regId} {
      allow read: if girisYapildi();
      allow create: if girisYapildi()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if adminMi()
        || (girisYapildi()
            && resource.data.uid == request.auth.uid
            && request.resource.data.uid == request.auth.uid);
    }

    /* --- HERKESE AÇIK ÜYE İSTATİSTİĞİ (public) ---
       Yalnızca ad, soyad, katıldığı ve görev sayısı tutulur.
       İletişim bilgisi (e-posta, telefon, öğrenci no) BURAYA YAZILMAZ.
       Herkes okuyabilir. Üye kendi satırını günceller, yönetici herkesininkini.
       Takvimde gösterilmez; yalnızca "Üyeler ve katılım" sayfasında listelenir.
       ŞİŞİRME ENGELİ: üye yazdığı sayı plan büyüklüğünü (meta/plan.count)
       geçemez; yönetici her zaman yazabilir. */
    match /public/{uid} {
      allow read: if true;
      /* Yönetici herkesin satırını oluşturabilir/gunceller;
         üye yalnizca kendi satırını (yalnızca bu alanlarla) yazabilir. */
      allow create: if adminMi()
        || (girisYapildi()
            && request.auth.uid == uid
            && dogrulandiMi()
            && uyeSatiriGecerli()
            && request.resource.data.keys()
                 .hasOnly(['ad', 'soyad', 'katildi', 'gorevli', 'guncelleAt']));
      allow update: if adminMi()
        || (girisYapildi()
            && request.auth.uid == uid
            && dogrulandiMi()
            && uyeSatiriGecerli()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['ad', 'soyad', 'katildi', 'gorevli', 'guncelleAt']));
      allow delete: if adminMi();
    }
    /* Üye istatistik satırı: tip denetimi + plan büyüklüğü üst sınırı.
       (İstemci zaten gerçek kayıtlardan hesaplar; bu kural el ile
       şişirilmiş sayaç yazımını engeller.) */
    function uyeSatiriGecerli() {
      return request.resource.data.ad is string
        && request.resource.data.ad.size() <= 80
        && request.resource.data.soyad is string
        && request.resource.data.soyad.size() <= 80
        && request.resource.data.katildi is int
        && request.resource.data.katildi >= 0
        && request.resource.data.gorevli is int
        && request.resource.data.gorevli >= 0
        && request.resource.data.katildi <= planSayisi()
        && request.resource.data.gorevli <= planSayisi();
    }
    function planSayisi() {
      return exists(/databases/$(database)/documents/meta/plan)
        && get(/databases/$(database)/documents/meta/plan).data.count is int
        ? get(/databases/$(database)/documents/meta/plan).data.count
        : 0;
    }

    /* --- DUYURULAR --- */
    match /news/{newsId} {
      allow read: if true;
      allow create, update, delete: if adminMi();
    }

    /* --- GERİ BİLDİRİMLER: hata bildirimi ---
       Herkes yazabilir (girişsiz bildirim için); YALNIZCA yönetici okur.
       KOTA KALKANI: ileti 2000 karakteri geçemez, tür sabittir. */
    match /reports/{reportId} {
      allow read: if adminMi();
      allow create: if true
        && request.resource.data.mesaj is string
        && request.resource.data.mesaj.size() <= 2000
        && request.resource.data.tur in ['hata', 'oneri'];
      allow update, delete: if adminMi();
    }

    /* --- ÖNERİ / GÖRÜŞ BİLDİRİMLERİ ---
       Kota kalkanı raporlarla aynıdır. */
    match /oneriler/{oneriId} {
      allow read: if adminMi();
      allow create: if true
        && request.resource.data.mesaj is string
        && request.resource.data.mesaj.size() <= 2000
        && request.resource.data.tur in ['hata', 'oneri'];
      allow update, delete: if adminMi();
    }

    /* --- KVKK: AÇIK RIZA KAYDI ---
       Kullanıcı YALNIZCA kendi rıza kaydını yazar (silme = rıza geri çekme).
       Kayıt yalnızca onay kutularının sonucunu ve metin sürümünü tutar;
       e-posta/IP gibi ek kimlik veri içermez. --- */
    match /kvkk/{uid} {
      allow read: if adminMi() || (girisYapildi() && request.auth.uid == uid);
      allow create, update: if girisYapildi()
        && request.auth.uid == uid
        && dogrulandiMi()
        && request.resource.data.keys().hasOnly([
             'surum', 'tarih', 'yetisk', 'aydinlatma', 'riza',
             'bulten', 'kanal', 'guncelleAt'])
        && request.resource.data.surum is string
        && request.resource.data.riza is bool
        && request.resource.data.aydinlatma is bool;
      allow delete: if adminMi() || (girisYapildi() && request.auth.uid == uid);
    }

    /* --- KVKK: VERİ SİLME / ERİŞİM TALEPLERİ ---
       Üye kendi talebini oluşturabilir; yalnızca yönetici okur ve sonuçlandırır. --- */
    match /talebler/{talepId} {
      allow read: if adminMi();
      allow create: if girisYapildi()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tur in ['silme', 'bilgi', 'erisim', 'düzeltme']
        && request.resource.data.aciklama is string
        && request.resource.data.aciklama.size() <= 2000
        && request.resource.data.keys().hasOnly([
             'uid', 'ad', 'eposta', 'tur', 'aciklama', 'durum', 'tarih']);
      allow update: if adminMi();
      allow delete: if adminMi();
    }

    /* --- ETKİNLİK SAYFASI İÇERİĞİ: herkes okur, yönetici yazar --- */
    match /events/{eventId}/sayfa/{doc} {
      allow read: if true;
      allow write: if adminMi();
    }

    /* --- KATILIM QR KODU ---
       ÖNCEKİ HÂLİ: allow read: if true → oturumsuz biri anahtarı okuyup
       kendi adına katılım yazabiliyordu (katılım sahteciliği).
       ŞİMDİ: anahtarı yalnızca giriş yapmış (ve e-postası doğrulanmış)
       üye okur — kod zaten üyeye gösteriliyor, gizli kalmalı değil. */
    match /events/{eventId}/qr/{doc} {
      allow read: if girisYapildi() && dogrulandiMi();
      allow write: if adminMi();
    }

    /* --- GÖREVLİLER: herkes okur, YALNIZCA yönetici atar --- */
    match /events/{eventId}/gorevli/{uid} {
      allow read: if true;
      allow write: if adminMi();
    }

    /* --- KATILANLAR ---
       Üye YALNIZCA kendi kaydını yazabilir ve yazarken o an geçerli olan
       QR kodunu göstermek zorundadır (kod 10 saniyede bir yenilenir).
       Böylece katılım kendi kendine uydurulamaz. --- */
    match /events/{eventId}/katilan/{uid} {
      /* Anahtar (qr) belge içinde bir süre kaldığı için okuma girişe ve
         e-posta doğrulamasına bağlandı: kimse canlı anahtarı toplayamaz. */
      allow read: if girisYapildi() && dogrulandiMi();
      /* Üye kendi kaydını QR koduyla yazar; YÖNETİCİ (kulüp adına
         düzeltme) doğrudan yazabilir — QR gerekmez. Böylece istatistik,
         profil ve yönetici paneli AYNI kayıtları görür.
         Alan kilidi: ad en fazla 80 karakter (kota kalkanı; e-posta
         istemci tarafından zaten temizlenir). */
      allow create: if adminMi()
        || (girisYapildi()
            && dogrulandiMi()
            && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['uid', 'ad', 'anahtar', 'at'])
            && request.resource.data.uid == uid
            && request.resource.data.ad is string
            && request.resource.data.ad.size() <= 80
            && request.resource.data.anahtar ==
                 get(/databases/$(database)/documents/events/$(eventId)/qr/anahtar).data.anahtar);
      /* Üye kendi kaydından anahtarı SİLEBİLİR (sunucu doğrulaması
         tamamlandıktan sonra temizlik) — başka alana dokunamaz.
         Yönetici düzeltmesi (çift okutma sonrası yeniden işaretleme)
         engellenmez. */
      allow update: if adminMi()
        || (girisYapildi()
            && dogrulandiMi()
            && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['anahtar'])
            && !('anahtar' in request.resource.data));
      allow delete: if adminMi();
    }

    /* --- ETKİNLİK YORUMLARI (sohbet) ---
       Herkes okur. Yorum yazabilmek için: giriş + e-posta doğrulanmış olmak
       VE o etkinliğe katılmış (ya da görevli olmak) gerekir.
       Böylece yalnızca o etkinliğe katılan üyeler konuşabilir. --- */
    match /events/{eventId}/yorumlar/{yorumId} {
      function yorumYazabilir() {
        return girisYapildi() && dogrulandiMi() && (
          adminMi() ||
          exists(/databases/$(database)/documents/events/$(eventId)/katilan/$(request.auth.uid)) ||
          exists(/databases/$(database)/documents/events/$(eventId)/gorevli/$(request.auth.uid))
        );
      }
      allow read: if true;
      allow create: if yorumYazabilir()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.metin is string
        && request.resource.data.metin.size() > 0
        && request.resource.data.metin.size() <= 500
        && request.resource.data.keys()
             .hasOnly(['uid', 'ad', 'metin', 'at']);
      allow update: if false;              /* yorumlar düzenlenmez */
      allow delete: if adminMi() || (girisYapildi()
        && resource.data.uid == request.auth.uid);
    }

    /* --- ESKİ ŞEMA (v2) KALINTILARI ---------------------------------
       Kökte "katilan" ve "gorevli" koleksiyonları kalmıştı; hiçbir kural
       onları açmadığı için collectionGroup sorguları TÜMÜYLE reddediliyor,
       üye istatistikleri sessizce 0 yazılıyordu.
       Artık hiçbir kod collectionGroup kullanmıyor (etkinlik etkinlik
       okunuyor); bu iki blok yalnızca YÖNETİCİNIN tek seferlik temizliği
       içindir. Kullanıcıların erişimi yoktur. */
    match /katilan/{doc} {
      allow read, write: if adminMi();
    }
    match /gorevli/{doc} {
      allow read, write: if adminMi();
    }

    /* --- KİŞİSEL VERİLER: yalnızca sahibi ---
       SİLME HAKKI (KVKK): yönetici, silme/erasure işlemi için bu belgeleri
       SİLEBİLİR ama OKUYAMAZ (içerik gizliliği korunur, iz temizlenir). */
    /* Notlar, yapılacaklar: yalnızca sahibi okur/yazar; yönetici silebilir */
    match /ud/{uid}/notes/{doc} {
      allow read, write: if girisYapildi() && request.auth.uid == uid;
      allow delete: if adminMi();
    }
    match /ud/{uid}/todos/{doc} {
      allow read, write: if girisYapildi() && request.auth.uid == uid;
      allow delete: if adminMi();
    }
    /* Ders programı: yalnızca sahibi görebilir/yazabilir; yönetici silebilir */
    match /ud/{uid}/ders/{doc} {
      allow read, write: if girisYapildi() && request.auth.uid == uid;
      allow delete: if adminMi();
    }
    /* Eski katılım kayıtları: yalnızca sahibi okur, yalnızca yönetici yazar
       (yeni katılım events/{id}/katilan altında, QR ile) */
    match /ud/{uid}/katilim/{doc} {
      /* YÖNETİCİ DÜZELTME HATASI: okuma yalnızca sahibine açıktı, yönetici
         başkasının kaydını göremiyordu (permission-denied) → panel boş
         açılıyor, yaptığı değişiklik "kaydedilmemiş" gibi görünüyordu. */
      allow read: if adminMi() || (girisYapildi() && request.auth.uid == uid);
      allow write: if adminMi();
    }

    /* --- KATILACAK (niyet bildirimi) --------------------------------
       Etkinlik sayfasındaki "Katılacağım" düğmesi buraya yazar.
       Herkes kaç kişinin katılacağını görebilir (sayı göstergesi için),
       ama yalnızca KENDİ kaydını yazabilir/silebilir. */
    /* --- KATILACAK BELGE MODELİ ---
       Belge kimliği: katilacak/{etkinlikKimligi}_{uyeKimligi}
       (Firestore belge yolu ÇİFT segmentli olmak zorundadır; üç segmentli
        yol bir KOLLEKSİYON'dur, belge olamaz.)
       Sayaç: db.collection('katilacak').get() + "ev" alanı filtresi
       (collectionGroup'a gerek yok → eski kalıntı koleksiyonları sorun çıkarmaz).
       İçerik: yalnızca zaman damgası ve kimlik alanları; İSİM YAZILMAZ. */
    match /katilacak/{docId} {
      /* "kaç kişi katılacak" sayacı: doğrulanmış üyeler okur (doğrulanmamış
         hesaplar üye niyetlerini toplayamaz). */
      allow read: if adminMi() || (girisYapildi() && dogrulandiMi());
      allow create: if (girisYapildi()
            && dogrulandiMi()
            && request.resource.data.keys().hasOnly(['at', 'ev', 'uid'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.ev is string
            && request.resource.data.at == request.time
            /* belge kimliği kendi üye kimliğini içermeli → başkasının
               yerine kayıt açılamaz */
            && docId == request.resource.data.ev + '_' + request.auth.uid)
        || adminMi();
      /* Olmayan belgeyi silmek sessizce başarılı sayılır (vazgeçme
         düğmesi, kayıt yokken hata vermez); başkasının kaydı resource
         üzerindeki uid denetimiyle korunur. */
      allow delete: if adminMi()
        || (girisYapildi()
            && (resource == null || resource.data.uid == request.auth.uid));
      allow update: if adminMi();
    }
    match /ud/{uid}/{document=**} {
      allow read, write: if false;
    }

    /* --- PLAN ÜST VERİSİ --- */
    match /meta/{doc} {
      allow read: if true;
      allow write: if adminMi();
    }

    /* --- GERİ KALAN HİÇBİR ŞEY KAPALI --- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}