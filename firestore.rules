rules_version = '2';
/* =====================================================================
   AKÜ Moleküler Biyoloji ve Genetik Topluluğu — DNA Takvimi
   Firestore güvenlik kuralları  (v3.12.0)
   ---------------------------------------------------------------------
   NASIL KULLANILIR:
   1) Firebase konsolu → Firestore Database → Rules
   2) Aşağıdaki metnin TAMAMINI sil, bunu yapıştır
   3) Publish
   ---------------------------------------------------------------------
   YETKİ NASIL BELİRLENİR?
   Yönetici, Firestore belgesindeki role alanına değil, GİRİŞ YAPAN
   hesabın e-postasına bakılarak belirlenir:
       request.auth.token.email == 'b.gul.baba.can@hotmail.com'
   Böylece ilk yönetici hesabının profil belgesi silinse bile yetkisi
   kaybolmaz. Bu e-posta Firebase Auth'a kayıtlıdır; parolayı yalnızca
   hesap sahibi bilir.
   ---------------------------------------------------------------------
   • ÜYELİK: yalnızca e-postası DOĞRULANMIŞ hesaplar members belgesi
     oluşturabilir. Doğrulanmamış hesap veritabanına üye yazılmaz.
   • PROFİL: kullanıcı kendi profilini günceller ama en fazla
     30 GÜNDE BİR (ayda bir kere). İlk üyelikten itibaren sayılır.
   • PLAN (events)     : herkes okur, yalnızca yönetici yazar
   • KAYIT (regs)      : üye yalnızca kendi kaydını ekler/siler
   • DUYURULAR (news)  : herkes okur, yalnızca yönetici yazar
   • GERİ BİLDİRİM     : reports + oneriler — herkes yazar,
                         YALNIZCA yönetici okur
   • KİŞİSEL VERİLER    : yalnızca sahibi görebilir/değiştirebilir
   • GERİ KALAN HER ŞEY: KAPALI
   ===================================================================== */
service cloud.firestore {
  match /databases/{database}/documents {

    function girisYapildi() {
      return request.auth != null;
    }

    function adminMail() {
      return 'b.gul.baba.can@hotmail.com';
    }

    /* Yönetici = bu e-posta ile giriş yapmış hesap */
    function adminMi() {
      return girisYapildi()
        && request.auth.token.email != null
        && request.auth.token.email == adminMail();
    }

    /* E-postası doğrulanmış kullanıcı */
    function dogrulandiMi() {
      return girisYapildi()
        && request.auth.token.email_verified == true;
    }

    /* Profil güncelleme aralığı: 30 gün */
    function profilSikiliMi() {
      return resource.data.profilGuncelAt != null
        && request.time - resource.data.profilGuncelAt < duration.value(30, 'd');
    }

    /* --- ÜYE PROFİLLERİ --- */
    match /members/{uid} {
      /* üyeler listeyi görür (iletişim / dernek işleri için) */
      allow read: if girisYapildi();

      /* YALNIZCA doğrulanmış e-posta üye olabilir */
      allow create: if girisYapildi()
        && request.auth.uid == uid
        && dogrulandiMi();

      /* yönetici her zaman düzenleyebilir;
         üye kendi bilgilerini düzenler ama ayda bir kez */
      allow update: if adminMi()
        || (girisYapildi()
            && request.auth.uid == uid
            && dogrulandiMi()
            && !profilSikiliMi());

      /* yönetici istediğini siler; üye de kendi hesabını silebilir
         (KVKK: hesap silme hakkı) */
      allow delete: if adminMi() || (girisYapildi() && request.auth.uid == uid);
    }

    /* --- PLAN: herkese açık okunur, yalnızca yönetici yazar --- */
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if adminMi();
    }

    /* --- ETKİNLİK KAYITLARI --- */
    match /regs/{regId} {
      allow read: if girisYapildi();
      allow create: if girisYapildi()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if adminMi()
        || (girisYapildi() && resource.data.uid == request.auth.uid);
    }

    /* --- DUYURULAR --- */
    match /news/{newsId} {
      allow read: if true;
      allow create, update, delete: if adminMi();
    }

    /* --- GERİ BİLDİRİMLER: hata bildirimi --- */
    match /reports/{reportId} {
      allow read: if adminMi();
      allow create: if true;
      allow update, delete: if adminMi();
    }

    /* --- ÖNERİ / GÖRÜŞ BİLDİRİMLERİ --- */
    match /oneriler/{oneriId} {
      allow read: if adminMi();
      allow create: if true;
      allow update, delete: if adminMi();
    }

    /* --- KİŞİSEL VERİLER: yalnızca sahibi --- */
    match /ud/{uid}/{document=**} {
      allow read, write: if girisYapildi() && request.auth.uid == uid;
    }

    /* --- PLAN ÜST VERİSİ --- */
    match /meta/{doc} {
      allow read: if true;
      allow write: if adminMi();
    }

    /* --- GERİ KALAN HİÇBİR ŞEY KAPALI --- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}